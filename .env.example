# --- Django core ---
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-me-to-a-random-50-char-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Render injects DATABASE_URL automatically in production) ---
DATABASE_URL=postgres://user:password@localhost:5432/bizynex_bot

# --- Telegram bot ---
BOT_TOKEN=123456789:AAExampleTelegramBotTokenHere
ADMIN_ID=123456789
WEBHOOK_SECRET=change-me-to-a-random-secret-string
WEBHOOK_PATH=/webhook/

# Render sets this automatically on deploy (e.g. https://bizynex-bot.onrender.com).
# Leave empty for local development.
RENDER_EXTERNAL_URL=

# --- Keep-alive (prevents the free Render instance from sleeping) ---
KEEPALIVE_ENABLED=True
KEEPALIVE_INTERVAL_SECONDS=780

# --- Logging ---
LOG_LEVEL=INFO
