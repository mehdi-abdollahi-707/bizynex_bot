# --- Django core ---
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-me-to-a-random-50-char-secret
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (your host's dashboard usually injects DATABASE_URL for you) ---
DATABASE_URL=postgres://user:password@localhost:5432/bizynex_bot

# --- Telegram bot ---
BOT_TOKEN=123456789:AAExampleTelegramBotTokenHere
ADMIN_ID=123456789
WEBHOOK_SECRET=change-me-to-a-random-secret-string
WEBHOOK_PATH=/webhook/

# --- Public URL (used to register the Telegram webhook + keep-alive self-ping) ---
# Leave ALL THREE empty for local development. In production, set exactly
# ONE of these — whichever matches how you deployed:
#   - PUBLIC_BASE_URL: set this yourself, on any platform (full URL, e.g.
#     https://your-app.example.com). The one guaranteed-to-work option.
#   - RENDER_EXTERNAL_URL: Render injects this automatically — don't set it by hand.
#   - RAILWAY_PUBLIC_DOMAIN: Railway injects this automatically once you
#     enable a public domain for the service — don't set it by hand.
PUBLIC_BASE_URL=
RENDER_EXTERNAL_URL=
RAILWAY_PUBLIC_DOMAIN=

# --- Keep-alive (prevents a sleeping free-tier instance, where applicable) ---
KEEPALIVE_ENABLED=True
KEEPALIVE_INTERVAL_SECONDS=780

# --- Logging ---
LOG_LEVEL=INFO
